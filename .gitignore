# dependencies
/node_modules

# package-manager config
# A project .npmrc is where `//registry.npmjs.org/:_authToken=` lives, and this
# repository is public. Ignored with NO carve-out: if a policy-only .npmrc is ever
# wanted here, that is a deliberate decision to take at the time, not a hole to leave
# open now. Machine-wide pnpm policy (the release-age gate) lives in pnpm's global
# config and does not need a file in this repo.
.npmrc

# astro
.astro/

# production
dist/

# misc
.DS_Store
Thumbs.db
*.pem
*.key
*.p12
*.pfx

# debug
.p
# env files
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

# secrets & credentials
credentials.json
service-account.json
secrets/

