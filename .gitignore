id_rsa
id_ecdsa
id_ed25519

# wallet / node key material
keystore/
*.keystore
wallet.json
mnemonic.txt

# Claude Code working directory (local only)
#
# Exception: CLAUDE.md is committed at the repo root and is deliberately NOT ignored
# here. It is a one-line `@AGENTS.md` import carrying no content of its own, and
# AGENTS.md is itself committed. Operator decision, matching tyto-brand and
# tyto-design-system. `.claude/` stays ignored whole: agent working files, session
# notes and scratch scripts are authored into it, and this repository is public.
.claude/

# Internal development directory
.local/

# Local pre-rebuild snapshots (rollback safety net, not repo history)

# Planning & internal docs
*.scratch.*
*.draft.*

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo

# Logs
logs/
tmp/
temp/

# Agent and editor config that can carry tokens. .mcp.json is Claude Code's
# project-scoped MCP config and lives at the repo root; CLAUDE.local.md is the
# local-only memory file alongside the committed CLAUDE.md.
.mcp.json
CLAUDE.local.md
.aws/
.vscode/mcp.json
.vscode/launch.json

# direnv exports secrets into the shell; .env* does not match these.
.envrc
.direnv/

# Key material beyond the pem/key/p12/pfx already covered above.
*.p8
*.der
*.asc
*.gpg
*.jks

# Stray logs and macOS AppleDouble files.
*.log
._*
