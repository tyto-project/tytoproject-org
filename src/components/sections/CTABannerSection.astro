---
import FadeIn from "@/components/ui/FadeIn.astro";
import { DISCUSSIONS_URL, DOCS_URL, RELEASES_URL } from "@/data/site";

const DOWNLOAD_URL = RELEASES_URL;
---

<section class="section-ty">
  <div class="container-ty">
    <FadeIn>
      <div class="panel-ty panel-ty--elev panel-ty--center">
        <h2 class="cta-banner__title">Get started</h2>

        <p class="cta-banner__body">
          One signed binary scales from a home node to institutional infrastructure. Download a
          release and run it; deployment, monitoring, and upgrades live in the operator guide.
        </p>

        <div class="cta-banner__actions">
          <a
            href={DOWNLOAD_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-ty btn-ty--primary"
          >
            Download
          </a>
          <a
            href={DOCS_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-ty cta-banner__secondary"
          >
            Documentation
          </a>
        </div>

        <a
          href={DISCUSSIONS_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="cta-banner__discussions"
        >
          Join discussions
        </a>
      </div>
    </FadeIn>
  </div>
</section>

<style>
  .cta-banner__title {
    font-size: clamp(1.5rem, 3vw + 0.5rem, 2.25rem);
    font-weight: var(--weight-heavy);
    letter-spacing: var(--tracking-tighter);
    line-height: var(--leading-tight);
    color: var(--text);
    margin-bottom: 1rem;
  }

  .cta-banner__body {
    font-size: var(--text-md);
    color: var(--text-muted);
    line-height: 1.65;
    margin-bottom: 2rem;
    max-width: 560px;
    margin-inline: auto;
  }

  .cta-banner__actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .cta-banner__secondary {
    background: var(--bg-card);
  }

  .cta-banner__discussions {
    display: inline-block;
    margin-top: 1.25rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-subtle);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .cta-banner__discussions:hover {
    color: var(--accent);
  }
</style>
