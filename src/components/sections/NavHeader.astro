---
import ThemeToggle from "@/components/ui/ThemeToggle.astro";
import { NAV_ROUTES, DOCS_URL, REPO_URL } from "@/data/site";

interface NavLink {
  label: string;
  href: string;
  external?: boolean;
}

// Derived from ROUTES rather than retyped, so a new route cannot be reachable in
// the footer but missing here. Only the off-site link is appended, because it is
// not a route.
const NAV_LINKS: readonly NavLink[] = [
  ...NAV_ROUTES.map((route) => ({ label: route.label, href: route.path })),
  { label: "Docs", href: DOCS_URL, external: true },
];
---

<header class="nav-ty site-nav">
  <div class="container-ty">
    <div class="site-nav__bar">
      <a href="/" class="site-nav__brand">
        <span class="site-nav__wordmark">TYTO</span>
        <span class="site-nav__tagline">Ethereum Virtual Machine Client</span>
      </a>

      <nav class="site-nav__desktop" aria-label="Primary">
        <ul class="site-nav__list">
          {
            NAV_LINKS.map((link) => (
              <li>
                <a
                  class="nav-link"
                  href={link.href}
                  target={link.external ? "_blank" : undefined}
                  rel={link.external ? "noopener noreferrer" : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="site-nav__actions">
        <ThemeToggle />
        <a href={REPO_URL} target="_blank" rel="noopener noreferrer" class="nav-github-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"
            ></path>
          </svg>
          GitHub
        </a>

        <button
          class="icon-btn site-nav__burger"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-nav"
        >
          <svg
            class="site-nav__icon-open"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
          <svg
            class="site-nav__icon-close"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>

    <nav id="mobile-nav" class="site-nav__mobile" aria-label="Mobile">
      <ul class="site-nav__list site-nav__list--stacked">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a
                class="nav-link site-nav__mobile-link"
                href={link.href}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noopener noreferrer" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  // Open state lives in the data-nav-open attribute; all visibility is CSS.
  const header = document.querySelector<HTMLElement>(".site-nav");
  const burger = header?.querySelector<HTMLButtonElement>(".site-nav__burger");
  const panel = header?.querySelector<HTMLElement>(".site-nav__mobile");

  function setOpen(open: boolean) {
    if (!header || !burger) return;
    header.toggleAttribute("data-nav-open", open);
    burger.setAttribute("aria-expanded", String(open));
    burger.setAttribute("aria-label", open ? "Close menu" : "Open menu");
  }

  burger?.addEventListener("click", () => {
    setOpen(!header?.hasAttribute("data-nav-open"));
  });

  panel?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setOpen(false));
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && header?.hasAttribute("data-nav-open")) {
      setOpen(false);
      burger?.focus();
    }
  });
</script>

<style>
  .site-nav__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
    gap: 1rem;
  }

  .site-nav__brand {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    text-decoration: none;
    flex-shrink: 0;
  }
  .site-nav__wordmark {
    font-family: var(--font-sans);
    font-weight: var(--weight-bold);
    font-size: 1.0625rem;
    letter-spacing: 0.06em;
    color: var(--text);
    line-height: var(--leading-tight);
  }
  .site-nav__tagline {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-subtle);
    line-height: 1;
  }

  .site-nav__list {
    display: flex;
    gap: 0.25rem;
    align-items: center;
    list-style: none;
  }
  .site-nav__list--stacked {
    flex-direction: column;
    align-items: stretch;
  }

  .site-nav__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .site-nav__mobile {
    display: none;
    border-top: 1px solid var(--border);
    padding-block: 0.75rem;
  }
  .site-nav__mobile-link {
    display: block;
    padding: 0.625rem 0.75rem;
    font-size: var(--text-base);
  }

  /* Burger swaps to a close icon only while the panel is open. */
  .site-nav__icon-close {
    display: none;
  }
  .site-nav[data-nav-open] .site-nav__icon-open {
    display: none;
  }
  .site-nav[data-nav-open] .site-nav__icon-close {
    display: block;
  }
  .site-nav[data-nav-open] .site-nav__mobile {
    display: block;
  }

  /* Mobile-first: burger visible, desktop nav hidden, and the reverse at 768px.
     Replaces the Tailwind hidden/md:flex pair the previous build used. */
  .site-nav__desktop {
    display: none;
    align-items: center;
  }
  .site-nav__burger {
    display: flex;
  }

  @media (min-width: 768px) {
    .site-nav__desktop {
      display: flex;
    }
    .site-nav__burger,
    .site-nav__mobile,
    .site-nav[data-nav-open] .site-nav__mobile {
      display: none;
    }
  }
</style>
