---
import HexCanvas from "@/components/ui/HexCanvas.astro";
import { CONTAINER_REF } from "@/data/site";
import HeroBrandCell from "@/components/ui/HeroBrandCell.astro";
import TechStackBadges from "@/components/ui/TechStackBadges.astro";
---

<section class="home-hero">
  <HexCanvas />
  <div class="container-ty home-hero__inner">
    <div class="cell-grid-2col home-hero__grid">
      <HeroBrandCell />

      <div class="hero-cell-overlay home-hero__body">
        <div class="home-hero__lede">
          <h1 class="home-hero__wordmark-block">
            <span class="home-hero__wordmark">TYTO</span>
            <span class="home-hero__tagline">Ethereum Virtual Machine Client</span>
          </h1>

          <p class="home-hero__prose">
            Tyto is a Scala execution client for the EVM ecosystem. One binary runs a network family
            by configuration rather than a new client per chain, so several networks run at once in
            one JVM process. It scales from a single home node to institutional deployments.
          </p>
        </div>

        <pre class="code-block home-hero__run"><code>docker run {CONTAINER_REF}</code></pre>

        <div class="home-hero__actions">
          <a href="/guide" class="btn-ty">Quick Start</a>
        </div>

        <TechStackBadges />
      </div>
    </div>
  </div>
</section>

<style>
  .home-hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }

  /* Lifts content above the absolutely-positioned HexCanvas. */
  .home-hero__inner {
    position: relative;
    z-index: 1;
  }

  .home-hero__grid {
    border: 1px solid var(--border);
  }

  .home-hero__body {
    position: relative;
    padding: 2.5rem clamp(2rem, 4vw, 3.5rem);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  .home-hero__status {
    position: absolute;
    top: 1.25rem;
    left: clamp(2rem, 4vw, 3.5rem);
  }

  .home-hero__lede {
    margin-block: auto;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* The page h1. Both halves are spans so the accessible name reads
     "TYTO Ethereum Virtual Machine Client" as one heading, rather than the
     brand alone. */
  .home-hero__wordmark-block {
    text-align: center;
  }

  .home-hero__wordmark {
    display: block;
    font-family: var(--font-sans);
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-widest);
    color: var(--text);
    line-height: var(--leading-tight);
  }

  /* Weight pinned because the h1 above it is bold and this is not. */
  .home-hero__tagline {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--text-subtle);
    margin-top: 0.375rem;
  }

  .home-hero__prose {
    font-size: clamp(0.9375rem, 1.2vw + 0.5rem, 1.0625rem);
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 52ch;
  }

  /* Sits between the lede and the CTA row, so the first thing after the pitch is
     the command that runs it. margin-top:auto on the actions row below still pins
     the CTAs to the bottom of the cell. */
  .home-hero__run {
    margin-top: 1.75rem;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 2rem;
    justify-content: center;
  }
</style>
