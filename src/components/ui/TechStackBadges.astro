---

<div class="os-platform-row stack-badges">
  {
    STACK.map((s) => (
      <span class="os-pill">
        <svg class="stack-badges__icon" aria-hidden="true" viewBox={s.viewBox} fill="currentColor">
          <path d={s.path} />
        </svg>
        {s.label}
      </span>
    ))
  }
</div>

<style>
  .stack-badges {
    justify-content: center;
    margin-block: 1rem 0;
  }

  .stack-badges__icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }
</style>
