---
import FadeIn from "@/components/ui/FadeIn.astro";

export interface ProofCard {
  title: string;
  lead: string;
  /** Inner SVG markup for a 24x24 line icon. Static, authored in the caller. */
  icon: string;
  /** Single mono line of evidence. Mutually exclusive with `items`. */
  proof?: string;
  /** Bulleted evidence. Mutually exclusive with `proof`. */
  items?: readonly string[];
}

interface Props {
  cards: readonly ProofCard[];
  /**
   * Pin the column count at desktop width instead of fitting as many as will go.
   * Use it when the card count would otherwise leave an orphan row: six cards
   * auto-fit to 4 + 2, where 3 + 3 is what the set actually means.
   */
  columns?: 3;
}

const { cards, columns } = Astro.props;
---

<div class="proof-grid" data-cols={columns}>
  {
    cards.map((card, i) => (
      <FadeIn delay={i * 100} class="proof-grid__cell">
        <div class="cell-ty proof-grid__card">
          <div class="icon-tile">
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <Fragment set:html={card.icon} />
            </svg>
          </div>
          <h3 class="proof-grid__title">{card.title}</h3>
          <p class="proof-grid__lead">{card.lead}</p>
          {card.proof && <p class="proof-grid__proof">{card.proof}</p>}
          {card.items && (
            <ul class="proof-grid__items">
              {card.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )}
        </div>
      </FadeIn>
    ))
  }
</div>

<style>
  .proof-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    border: 1px solid var(--border);
    margin-bottom: 1px;
  }

  /* Hairline seams between cards. A grid gap would show the section background
     through the seam instead of a clean rule. */
  .proof-grid__cell + .proof-grid__cell {
    border-top: 1px solid var(--border);
  }
  @media (min-width: 880px) {
    .proof-grid__cell + .proof-grid__cell {
      border-top: none;
      border-left: 1px solid var(--border);
    }
  }

  /* Fixed three-up. Adjacency cannot draw the seams once the grid wraps: the
     first cell of row two is still "+ cell", so it would take a left border and
     lose its top one. With the column count known, position does it instead. */
  @media (min-width: 880px) {
    .proof-grid[data-cols="3"] {
      grid-template-columns: repeat(3, 1fr);
    }
    .proof-grid[data-cols="3"] .proof-grid__cell:nth-child(3n + 1) {
      border-left: none;
    }
    .proof-grid[data-cols="3"] .proof-grid__cell:nth-child(n + 4) {
      border-top: 1px solid var(--border);
    }
  }

  .proof-grid__card {
    padding: 1.75rem;
    height: 100%;
    border: none;
  }

  .proof-grid__title {
    font-size: var(--text-md);
    font-weight: var(--weight-bold);
    color: var(--text);
    margin-bottom: 0.375rem;
    letter-spacing: -0.01em;
  }

  .proof-grid__lead {
    font-size: var(--text-base);
    color: var(--text-muted);
    line-height: 1.55;
  }

  .proof-grid__proof {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-subtle);
    line-height: 1.55;
    margin-top: 0.875rem;
  }

  .proof-grid__items {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin-top: 0.875rem;
  }

  .proof-grid__items li {
    position: relative;
    padding-left: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.55;
  }

  /* Decorative marker by construction: generated content is not announced, so
     the list stays a list without an aria-hidden span per item. */
  .proof-grid__items li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: var(--weight-bold);
    font-size: 0.875rem;
  }
</style>
