---
export interface DataTableColumn {
  label: string;
  /** Render this column's cells in the mono face. */
  mono?: boolean;
}

interface Props {
  /** Announced to screen readers; visually hidden since a heading precedes it. */
  caption: string;
  columns: readonly DataTableColumn[];
  /** Row cells, in column order. The first cell becomes the row header. */
  rows: readonly (readonly string[])[];
  /** Width below which the table scrolls rather than crushing its columns. */
  minWidth?: string;
}

const { caption, columns, rows, minWidth = "40rem" } = Astro.props;
---

<div class="table-scroll-ty">
  <table class="table-ty data-table" style={`--data-table-min: ${minWidth}`}>
    <caption class="table-ty__caption">{caption}</caption>
    <thead>
      <tr>
        {columns.map((col) => <th scope="col">{col.label}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            {row.map((cell, ci) =>
              ci === 0 ? (
                <th
                  scope="row"
                  class:list={["data-table__rowhead", columns[ci]?.mono && "data-table__mono"]}
                >
                  {cell}
                </th>
              ) : (
                <td class:list={[columns[ci]?.mono && "data-table__mono"]}>{cell}</td>
              ),
            )}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  /* Column count drives this, so it stays with the consumer rather than upstream.
     .table-scroll-ty supplies the horizontal escape once the table exceeds it. */
  .data-table {
    min-width: var(--data-table-min);
  }

  /* Row headers read as labels, not data. */
  .data-table__rowhead {
    font-weight: var(--weight-semibold);
    color: var(--text);
  }

  .data-table__mono {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
</style>
